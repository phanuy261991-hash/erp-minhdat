erDiagram
    ROLES ||--o{ USERS : "gan cho"
    ROLES ||--o{ ROLE_PERMISSIONS : "co quyen"
    USERS ||--o{ STOCK_RECEIPTS : "tao"
    USERS ||--o{ STOCK_ISSUES : "tao"
    PARTNERS ||--o{ STOCK_RECEIPTS : "la NCC"
    PARTNERS ||--o{ STOCK_ISSUES : "la khach hang"
    USERS ||--o{ PARTNERS : "phu trach (nullable)"
    PARTNERS ||--o{ DEBT_LEDGER : "co cong no"
    USERS ||--o{ DEBT_LEDGER : "ghi nhan"
    CUSTOMER_CATEGORIES ||--o{ PARTNERS : "phan loai (chi khach hang)"
    PARTNERS ||--o{ WARRANTIES : "co bao hanh (chi khach hang)"
    USERS ||--o{ WARRANTIES : "tao"
    PRODUCTS ||--o{ STOCK_RECEIPT_ITEMS : "thuoc ve"
    PRODUCTS ||--o{ STOCK_ISSUE_ITEMS : "thuoc ve"
    PRODUCTS ||--o{ STOCK_MOVEMENTS : "bien dong"
    PRODUCTS ||--o{ STOCK_LOTS : "co lo hang"
    PRODUCTS ||--o{ PRODUCT_CHANGE_LOG : "co lich su sua"
    USERS ||--o{ PRODUCT_CHANGE_LOG : "nguoi sua"
    STOCK_RECEIPTS ||--o{ STOCK_RECEIPT_ITEMS : "gom"
    STOCK_ISSUES ||--o{ STOCK_ISSUE_ITEMS : "gom"
    STOCK_RECEIPTS ||--o{ STOCK_MOVEMENTS : "phat sinh"
    STOCK_ISSUES ||--o{ STOCK_MOVEMENTS : "phat sinh"
    STOCK_RECEIPTS ||--o{ STOCK_LOTS : "tao lo"
    USERS ||--o{ CONTACTS : "tao (khong lien quan PARTNERS)"
    USERS ||--o{ NOTIFICATION_READS : "danh dau da doc"
    NOTIFICATIONS ||--o{ NOTIFICATION_READS : "trang thai doc theo tung user"
    USERS ||--o{ PRINT_TEMPLATES : "cap nhat (nullable)"

    ROLES {
        int id PK
        string name
        boolean is_protected "1 = Admin, khong sua/xoa duoc"
        datetime created_at
    }

    ROLE_PERMISSIONS {
        int role_id PK_FK
        string module_key PK "kho, cong_no, bao_cao, nguoi_dung, cau_hinh..."
    }

    USERS {
        int id PK
        string username
        string password_hash
        string full_name
        int role_id FK
        boolean is_active
        datetime created_at
    }

    COMPANY_SETTINGS {
        int id PK "luon = 1, chi 1 dong duy nhat"
        string company_name
        string address
        string tax_code
        string email
        string website
        string phones "mang JSON dang text, tu 2 so tro len"
        string bank_name
        string bank_branch
        string bank_account_number
        string bank_account_holder
        string print_note "ghi chu hien thi duoi bang ke khi in phieu xuat kho (Phase 4)"
        datetime updated_at
    }

    WAREHOUSE_SETTINGS {
        string key PK "allow_negative_stock, costing_method (binh_quan_gia_quyen|fifo), backup_path (Phase 5)..."
        string value
        datetime updated_at
    }

    PRODUCTS {
        int id PK
        string code
        string name
        string unit
        real cost_price "gia von nhap tay/tham chieu - gia von THUC TE tinh tu STOCK_LOTS"
        real sale_price
        int low_stock_threshold
        boolean is_active "0 = ngung kinh doanh, van hien trong danh sach"
        datetime created_at
    }

    STOCK_LOTS {
        int id PK
        int product_id FK
        int receipt_id FK
        real unit_cost "gia von cua lo - da tru chiet khau (net)"
        real quantity_received
        real quantity_remaining "tru dan theo FIFO khi xuat, bat ke costing_method"
        datetime created_at
    }

    PRODUCT_CHANGE_LOG {
        int id PK
        int product_id FK
        int changed_by FK
        string field_name
        string old_value
        string new_value
        datetime created_at
    }

    PARTNERS {
        int id PK
        string type "nha_cung_cap hoac khach_hang"
        string name
        string phone
        string address
        int category_id FK "nullable, chi ap dung type=khach_hang (migration 015)"
        int assigned_user_id FK "nullable, 'Nguoi phu trach' - hien tai chi hien tren customers.html (migration 020)"
        datetime created_at
    }

    CUSTOMER_CATEGORIES {
        int id PK
        string name "UNIQUE, vd VIP/Dai ly/Khach le"
        real debt_limit "nullable = khong gioi han, CHI de canh bao (khong chan cung)"
        datetime created_at
    }

    WARRANTIES {
        int id PK
        int partner_id FK "chi khach_hang"
        string phone "snapshot, fill tu doi tac nhung sua duoc"
        string address "snapshot, fill tu doi tac nhung sua duoc"
        string acceptance_date "YYYY-MM-DD, ngay nghiem thu"
        string expiry_date "YYYY-MM-DD, ngay het han - nguon tinh 'con lai bao nhieu ngay'"
        real duration_value "gia tri thoi gian bao hanh nguoi dung chon"
        string duration_unit "ngay, thang, hoac nam"
        string note
        boolean is_active "0 = vo hieu hoa"
        int created_by FK
        datetime created_at
        datetime updated_at
    }

    STOCK_RECEIPTS {
        int id PK
        string code "ma noi bo tu sinh PN000001..."
        string order_code "ma hoa don/don hang cua NCC, tu do, khong bat buoc"
        int partner_id FK "nullable"
        int created_by FK
        string note
        string payment_status "da_thanh_toan hoac cong_no - doi xung stock_issues (Phase 3)"
        string adjusts_type "nullable: 'receipt' hoac 'issue' - phieu nay dieu chinh bu tru cho phieu nao"
        int adjusts_id "nullable, ket hop adjusts_type de tro toi phieu goc"
        int project_id "nullable (ke hoach migration 023) - can co de 'da xuat cho du an' tru duoc vat tu tra ve kho"
        datetime created_at "co the chinh khi lap phieu - anh huong thu tu FIFO/binh quan gia quyen"
        int is_return "migration 032, mac dinh 0 - 1 la phieu 'Tra hang' (khach hang tra lai hang da mua), an khoi danh sach Phieu nhap kho"
        string status "migration 033, mac dinh da_tru_kho - phieu tra hang: cho_tru_kho (moi Luu, chua dong stock_movements/debt_ledger) hoac da_tru_kho (da Tru kho, khoa vinh vien). Phieu nhap thuong luon da_tru_kho"
    }

    STOCK_RECEIPT_ITEMS {
        int id PK
        int receipt_id FK
        int product_id FK
        real quantity
        real unit_price "gia goc, chua tru chiet khau - doi chieu hoa don NCC. Voi dong thuoc phieu is_return=1: la gia von binh quan tu dong tinh, khong phai gia nguoi dung nhap"
        real discount_percent "0-100, gia von thuc te = unit_price * (1 - discount_percent/100)"
        real sale_price "migration 032, nullable - 'Gia ban' tren dong hang tra (chi co gia tri khi thuoc phieu is_return=1), dung tinh so tien giam cong no"
    }

    STOCK_ISSUES {
        int id PK
        string code
        int partner_id FK "nullable"
        int created_by FK
        string note
        string payment_status "da_thu_tien hoac cong_no"
        string adjusts_type "nullable: 'receipt' hoac 'issue' - phieu nay dieu chinh bu tru cho phieu nao"
        int adjusts_id "nullable, ket hop adjusts_type de tro toi phieu goc"
        int project_id "nullable (ke hoach migration 023) - nguon tinh vat tu da xuat + cong no cua du an"
        datetime created_at
    }

    STOCK_ISSUE_ITEMS {
        int id PK
        int issue_id FK
        int product_id FK
        real quantity
        real unit_price "gia goc, chua tru chiet khau"
        real discount_percent "0-100, chi anh huong doanh thu ghi cong no - KHONG anh huong unit_cost cua movement"
    }

    STOCK_MOVEMENTS {
        int id PK
        int product_id FK
        string movement_type
        real quantity
        real unit_cost "snapshot gia von tai thoi diem phat sinh - khong tinh lai ve sau"
        string reference_type
        int reference_id
        datetime created_at
    }

    DEBT_LEDGER {
        int id PK
        int partner_id FK
        string type "no (tang so du) hoac tra (giam so du)"
        real amount
        string reference_type "receipt, issue, hoac payment (thanh toan thu cong)"
        int reference_id "nullable - NULL khi reference_type = payment"
        string note
        int created_by FK
        datetime created_at
        boolean is_adjustment "1 = dong 'Dieu chinh cong no' thu cong (migration 016), khac dong tu dong/thanh toan that"
        int project_id "nullable (ke hoach migration 023) - NHAN phan loai du an, so cai VAN thuoc khach hang"
        int milestone_id "nullable (ke hoach migration 024) - dot thanh toan duoc thu. CO Y khong them 'project_milestone' vao CHECK cua reference_type (SQLite khong ALTER duoc CHECK)"
    }

    CASH_BOOK_SETTINGS {
        int id PK "luon = 1, chi 1 dong duy nhat"
        real opening_balance "quy dau ky goc, nhap 1 lan, tu dong cong don qua cac thang"
        datetime updated_at
    }

    CASH_CATEGORIES {
        int id PK
        string name "vd Thu ban hang, Chi mua hang"
        string type "thu hoac chi"
        datetime created_at
    }

    CASH_VOUCHERS {
        int id PK
        string code "PT000001... (thu) hoac PC000001... (chi), rieng tung type"
        string type "thu hoac chi"
        int category_id FK "NOT NULL, phai cung type voi phieu"
        string counterpart_name "nguoi nop/nhan, ten tu do - KHONG lien ket partners"
        int handled_by FK "nguoi thu/chi (nhan vien xu ly), nullable"
        real amount "> 0"
        string note
        boolean record_business_result "1 = hach toan KQKD, chi luu co, chua co bao cao dung"
        int created_by FK "nguoi tao ban ghi trong he thong"
        datetime created_at "co the chinh khi lap phieu - quyet dinh thuoc thang nao"
    }

    CASH_CATEGORIES ||--o{ CASH_VOUCHERS : "phan loai"
    USERS ||--o{ CASH_VOUCHERS : "nguoi thu/chi"
    USERS ||--o{ CASH_VOUCHERS : "nguoi tao"

    SCHEMA_MIGRATIONS {
        int version PK
        datetime applied_at
    }

    %% ===== Module "Quan ly du an" (ke hoach 2026-08-04, CHUA TAO) =====
    %% Xem docs/PRD.md muc 4.12, docs/Plan.md muc 2/4, docs/DECISIONS.md muc 2026-08-04.
    %% Nguyen tac: so cai cong no VAN thuoc khach hang - du an chi gan them nhan project_id
    %% len dong debt_ledger de loc, KHONG co so cong no rieng.

    PARTNERS ||--o{ PROJECTS : "la khach hang (chi khach_hang)"
    USERS ||--o{ PROJECTS : "nguoi phu trach"
    PROJECTS ||--o{ PROJECT_MEMBERS : "co nguoi tham gia"
    USERS ||--o{ PROJECT_MEMBERS : "tham gia"
    PROJECTS ||--o{ PROJECT_PHASES : "gom giai doan"
    PROJECT_PHASES ||--o{ PROJECT_TASKS : "gom cong viec"
    USERS ||--o{ PROJECT_TASKS : "duoc giao (phai thuoc project_members)"
    PROJECTS ||--o{ PROJECT_MATERIAL_PLAN : "co du toan vat tu"
    PRODUCTS ||--o{ PROJECT_MATERIAL_PLAN : "duoc du toan"
    PROJECTS ||--o{ PROJECT_PAYMENT_MILESTONES : "co dot thanh toan"
    PROJECTS ||--o{ PROJECT_VARIATIONS : "co phat sinh"
    PROJECTS ||--o{ STOCK_ISSUES : "duoc xuat vat tu (project_id nullable)"
    PROJECTS ||--o{ STOCK_RECEIPTS : "duoc tra vat tu ve kho (project_id nullable)"
    PROJECTS ||--o{ DEBT_LEDGER : "nhan phan loai (project_id nullable)"
    PROJECT_PAYMENT_MILESTONES ||--o{ DEBT_LEDGER : "duoc thu qua (milestone_id nullable)"

    PROJECT_PHASE_TEMPLATES {
        int id PK
        string name "danh muc Giai doan mau, menu Cau hinh"
        int sort_order
        datetime created_at
    }

    PROJECTS {
        int id PK
        string code "tu sinh DA000001..."
        string name "ten du an = ten cong trinh (cau truc 1 cap)"
        int partner_id FK "BAT BUOC, phai la type=khach_hang"
        string contract_no "so hop dong"
        string contract_date "YYYY-MM-DD, ngay ky hop dong"
        string site_address "dia chi cong trinh"
        real contract_value "gia tri hop dong GOC - gia tri thuc te = gia tri nay + phat sinh da duyet"
        string start_date
        string planned_end_date "ngay hoan thanh du kien"
        string actual_end_date "nullable"
        string status "chuan_bi, dang_thuc_hien, tam_dung, hoan_thanh, huy"
        int manager_id FK "nguoi phu trach du an, nullable"
        string note
        int created_by FK
        datetime created_at
        datetime updated_at
    }

    PROJECT_MEMBERS {
        int id PK
        int project_id FK
        int user_id FK
        string role_in_project "vai tro trong du an - o chu TU DO, khong co danh muc rieng"
    }

    PROJECT_PHASES {
        int id PK
        int project_id FK
        string name "copy tu PROJECT_PHASE_TEMPLATES luc tao du an roi TACH ROI hoan toan"
        int sort_order
        string planned_start
        string planned_end
        string actual_start
        string actual_end
        string status "chua_bat_dau, dang_lam, hoan_thanh"
        string note
    }

    PROJECT_TASKS {
        int id PK
        int phase_id FK "CHI luu phase_id - lay du an qua JOIN, khong luu project_id trung lap"
        string name
        int assigned_user_id FK "nullable, chi chon duoc nguoi trong project_members"
        string start_date
        string due_date
        string actual_start_date "nhap tay (migration 023, 2026-08-04) - giong actual_start cua PROJECT_PHASES"
        string actual_end_date "nhap tay (migration 023) - nguon tinh tre tien do, thay the hoan toan completed_at"
        string status "chua_lam, dang_lam, hoan_thanh - nguon DUY NHAT tinh % tien do"
        datetime completed_at "KHONG con dung tu migration 023 - giu lai cot cu, chi con du lieu lich su"
        string note
        int created_by FK
        datetime created_at
        datetime updated_at
    }

    PROJECT_MATERIAL_PLAN {
        int id PK
        int project_id FK
        int product_id FK
        real quantity "so luong DU TOAN - 'da xuat' khong luu, tinh tu phieu xuat TRU phieu nhap gan du an"
        string note
    }

    PROJECT_PAYMENT_MILESTONES {
        int id PK
        int project_id FK
        string name "ten dot, vd Tam ung / Sau nghiem thu / Giu bao hanh"
        int sort_order
        real amount "so tien cua dot"
        real percent "nullable, neu nhap theo % gia tri hop dong"
        string due_date
        string note
        string recipient_name "khong bat buoc, 'Gui den' tren phieu in"
        string recipient_title "khong bat buoc, CHECK anh/chi/cong_ty/don_vi"
        datetime created_at
    }

    PROJECT_VARIATIONS {
        int id PK
        int project_id FK
        string type "chi_phi (co tien, duyet thi cong vao gia tri HD) hoac van_de (nhat ky, amount=0)"
        string title
        real amount
        string occurred_date
        string description
        string status "chi_phi: cho_duyet/da_duyet/tu_choi - van_de: dang_xu_ly/da_xu_ly"
        string resolution "cach xu ly, dung cho loai van_de"
        int created_by FK
        datetime created_at
        datetime updated_at
    }

    CONTACTS {
        int id PK
        string full_name
        string phone "nullable"
        string address "nullable"
        string occupation "nullable"
        string date_of_birth "nullable, YYYY-MM-DD"
        string hobby "nullable"
        string note "nullable"
        int created_by FK
        datetime created_at
        datetime updated_at
    }

    NOTIFICATION_SETTINGS {
        int id PK "CHECK id=1, singleton"
        boolean supplier_payment_enabled
        boolean customer_payment_enabled
        boolean birthday_enabled
        string birthday_reminder_days "CSV so ngay, vd '3,1,0'"
        string last_birthday_check_date "nullable, chi mang tinh thong tin"
        datetime updated_at
    }

    NOTIFICATIONS {
        int id PK
        string type "supplier_payment | customer_payment | birthday"
        string title
        string message "nullable"
        string reference_type "nullable"
        int reference_id "nullable"
        string dedupe_key "nullable, UNIQUE khi co gia tri"
        datetime created_at
    }

    NOTIFICATION_READS {
        int notification_id PK_FK
        int user_id PK_FK
        datetime read_at
    }

    PRINT_TEMPLATES {
        int id PK
        string type UK "vd 'stock_issue', mo rong sau (stock_receipt...)"
        string name
        string orientation "portrait | landscape"
        string header_html "vung soan thao tu do, truoc bang san pham"
        string footer_html "vung soan thao tu do, sau bang san pham"
        string table_columns "JSON mang key cot da bat, dung thu tu"
        datetime updated_at
        int updated_by FK "nullable"
    }

erDiagram
    ROLES ||--o{ USERS : "gan cho"
    ROLES ||--o{ ROLE_PERMISSIONS : "co quyen"
    USERS ||--o{ STOCK_RECEIPTS : "tao"
    USERS ||--o{ STOCK_ISSUES : "tao"
    PARTNERS ||--o{ STOCK_RECEIPTS : "la NCC"
    PARTNERS ||--o{ STOCK_ISSUES : "la khach hang"
    PARTNERS ||--o{ DEBT_LEDGER : "co cong no"
    USERS ||--o{ DEBT_LEDGER : "ghi nhan"
    PRODUCTS ||--o{ STOCK_RECEIPT_ITEMS : "thuoc ve"
    PRODUCTS ||--o{ STOCK_ISSUE_ITEMS : "thuoc ve"
    PRODUCTS ||--o{ STOCK_MOVEMENTS : "bien dong"
    PRODUCTS ||--o{ STOCK_LOTS : "co lo hang"
    PRODUCTS ||--o{ PRODUCT_CHANGE_LOG : "co lich su sua"
    USERS ||--o{ PRODUCT_CHANGE_LOG : "nguoi sua"
    STOCK_RECEIPTS ||--o{ STOCK_RECEIPT_ITEMS : "gom"
    STOCK_ISSUES ||--o{ STOCK_ISSUE_ITEMS : "gom"
    STOCK_RECEIPTS ||--o{ STOCK_MOVEMENTS : "phat sinh"
    STOCK_ISSUES ||--o{ STOCK_MOVEMENTS : "phat sinh"
    STOCK_RECEIPTS ||--o{ STOCK_LOTS : "tao lo"

    ROLES {
        int id PK
        string name
        boolean is_protected "1 = Admin, khong sua/xoa duoc"
        datetime created_at
    }

    ROLE_PERMISSIONS {
        int role_id PK_FK
        string module_key PK "kho, cong_no, bao_cao, nguoi_dung, cau_hinh..."
    }

    USERS {
        int id PK
        string username
        string password_hash
        string full_name
        int role_id FK
        boolean is_active
        datetime created_at
    }

    COMPANY_SETTINGS {
        int id PK "luon = 1, chi 1 dong duy nhat"
        string company_name
        string address
        string tax_code
        string email
        string website
        string phones "mang JSON dang text, tu 2 so tro len"
        string bank_name
        string bank_branch
        string bank_account_number
        string bank_account_holder
        string print_note "ghi chu hien thi duoi bang ke khi in phieu xuat kho (Phase 4)"
        datetime updated_at
    }

    WAREHOUSE_SETTINGS {
        string key PK "allow_negative_stock, costing_method (binh_quan_gia_quyen|fifo)..."
        string value
        datetime updated_at
    }

    PRODUCTS {
        int id PK
        string code
        string name
        string unit
        real cost_price "gia von nhap tay/tham chieu - gia von THUC TE tinh tu STOCK_LOTS"
        real sale_price
        int low_stock_threshold
        boolean is_active "0 = ngung kinh doanh, van hien trong danh sach"
        datetime created_at
    }

    STOCK_LOTS {
        int id PK
        int product_id FK
        int receipt_id FK
        real unit_cost "gia von cua lo - da tru chiet khau (net)"
        real quantity_received
        real quantity_remaining "tru dan theo FIFO khi xuat, bat ke costing_method"
        datetime created_at
    }

    PRODUCT_CHANGE_LOG {
        int id PK
        int product_id FK
        int changed_by FK
        string field_name
        string old_value
        string new_value
        datetime created_at
    }

    PARTNERS {
        int id PK
        string type "nha_cung_cap hoac khach_hang"
        string name
        string phone
        string address
        datetime created_at
    }

    STOCK_RECEIPTS {
        int id PK
        string code "ma noi bo tu sinh PN000001..."
        string order_code "ma hoa don/don hang cua NCC, tu do, khong bat buoc"
        int partner_id FK "nullable"
        int created_by FK
        string note
        string payment_status "da_thanh_toan hoac cong_no - doi xung stock_issues (Phase 3)"
        string adjusts_type "nullable: 'receipt' hoac 'issue' - phieu nay dieu chinh bu tru cho phieu nao"
        int adjusts_id "nullable, ket hop adjusts_type de tro toi phieu goc"
        datetime created_at "co the chinh khi lap phieu - anh huong thu tu FIFO/binh quan gia quyen"
    }

    STOCK_RECEIPT_ITEMS {
        int id PK
        int receipt_id FK
        int product_id FK
        real quantity
        real unit_price "gia goc, chua tru chiet khau - doi chieu hoa don NCC"
        real discount_percent "0-100, gia von thuc te = unit_price * (1 - discount_percent/100)"
    }

    STOCK_ISSUES {
        int id PK
        string code
        int partner_id FK "nullable"
        int created_by FK
        string note
        string payment_status "da_thu_tien hoac cong_no"
        string adjusts_type "nullable: 'receipt' hoac 'issue' - phieu nay dieu chinh bu tru cho phieu nao"
        int adjusts_id "nullable, ket hop adjusts_type de tro toi phieu goc"
        datetime created_at
    }

    STOCK_ISSUE_ITEMS {
        int id PK
        int issue_id FK
        int product_id FK
        real quantity
        real unit_price "gia goc, chua tru chiet khau"
        real discount_percent "0-100, chi anh huong doanh thu ghi cong no - KHONG anh huong unit_cost cua movement"
    }

    STOCK_MOVEMENTS {
        int id PK
        int product_id FK
        string movement_type
        real quantity
        real unit_cost "snapshot gia von tai thoi diem phat sinh - khong tinh lai ve sau"
        string reference_type
        int reference_id
        datetime created_at
    }

    DEBT_LEDGER {
        int id PK
        int partner_id FK
        string type "no (tang so du) hoac tra (giam so du)"
        real amount
        string reference_type "receipt, issue, hoac payment (thanh toan thu cong)"
        int reference_id "nullable - NULL khi reference_type = payment"
        string note
        int created_by FK
        datetime created_at
    }

    SCHEMA_MIGRATIONS {
        int version PK
        datetime applied_at
    }
